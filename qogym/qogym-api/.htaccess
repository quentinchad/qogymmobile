# En-têtes CORS
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # CRITIQUE : Transférer le header Authorization
    # Sans ça, PHP ne reçoit pas le token !
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # Gérer les requêtes OPTIONS (preflight CORS)
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
    
    # Routes API
    RewriteRule ^api/auth/?$ auth.php [L,QSA]
    RewriteRule ^api/sessions/?$ sessions.php [L,QSA]
    RewriteRule ^api/qojim-sessions/?$ qojim_sessions.php [L,QSA]
    RewriteRule ^api/workouts/?$ workouts.php [L,QSA]
    RewriteRule ^api/admin/?$ admin.php [L,QSA]
</IfModule>

# Protection des fichiers sensibles
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>
